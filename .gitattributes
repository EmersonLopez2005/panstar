# shell 脚本必须用 LF，否则在 Linux VPS 上会因 CRLF 报 `bad interpreter: /bin/sh^M`
*.sh text eol=lf
entrypoint.sh text eol=lf

# Dockerfile 与 compose 也统一 LF
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Python 保持 LF
*.py text eol=lf

# 文本文件统一 LF，避免各处 diff 噪音
*.md text eol=lf
*.txt text eol=lf
*.example text eol=lf
