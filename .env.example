# PanstarCloud 自动签到 —— 环境变量配置示例
# 复制为 .env 后填写（青龙面板里直接加到「环境变量」也行）

# ========== 账号配置 ==========
# 方式 A（推荐，多账号）：账号1:密码1&账号2:密码2
PS_USER_PASS=你的邮箱:你的密码
#
# 方式 B（单账号）
# PS_USER=your@example.com
# PS_PASS=你的密码

# 站点地址（一般不用改）
# PS_DOMAIN=https://panstar.ai

# 2FA 密钥（账号开了两步验证才需要，Base32）
# PS_TOTP=

# ========== Turnstile 通道 ==========
#
# 站点签到强制要 Cloudflare Turnstile token（checkinSecurityState=REQUIRED）。
# **本项目不需要打码服务** —— 自带的浏览器自己就能跑出 token。
#
# 路径 1：浏览器代理（推荐）
#   常驻的浏览器服务去跑挑战。它跑在有头浏览器 + 持久化 profile + 干净出口 IP 里，
#   过 Cloudflare 的成功率最高。见 agent/ 目录，部署：bash install_vps.sh --agent
#   LOGIN_AGENT_URL=http://127.0.0.1:3000
#   LOGIN_AGENT_TOKEN=与 agent 的 AGENT_TOKEN 保持一致
#
# 路径 2：本地浏览器
#   在本机起一个同样的浏览器（需要装 camoufox，见 install_vps.sh）。
#   PS_BROWSER_PROFILE=/root/panstar-autosign/data/browser
#   PS_BROWSER_HEADLESS=false        # 必须 false，headless 过不了
#
# 两条路径按顺序尝试，任意一条成功即可。
LOGIN_AGENT_URL=
LOGIN_AGENT_TOKEN=

# 浏览器 profile 名（多个账号可用不同 profile 隔离指纹）
# PS_PROFILE=default

# 覆盖站点用的 site key（一般不用改）
# PS_TURNSITE_SITE_KEY=0x4AAAAAAD4S6pSwBl0NuILe

# ========== 通知服务（可选）============
# 不配也能正常签到，只是没有推送。配几个就推几个，会同时发。

# ---- Telegram ----
# 1) 找 @BotFather 发 /newbot，拿到 token
# 2) 先给 bot 随便发句话，再打开
#    https://api.telegram.org/bot<token>/getUpdates
#    里面的 "chat":{"id":<你的数字ID>} 就是 TG_USER_ID
# TG_BOT_TOKEN=
# TG_USER_ID=

# ---- 企业微信机器人 ----
# 群机器人 Webhook 地址里 key= 后面那串
# QYWX_KEY=

# ---- 钉钉机器人 ----
# DD_BOT_TOKEN=
# DD_BOT_SECRET=
